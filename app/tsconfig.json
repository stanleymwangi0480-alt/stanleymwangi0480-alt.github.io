{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": false, "skipLibCheck": true, "noEmit": true,
    "lib": ["esnext", "dom", "dom.iterable"], "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true,
    "types": ["vite/client"], "baseUrl": ".", "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
